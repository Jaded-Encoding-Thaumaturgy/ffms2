set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>" CACHE STRING "" FORCE)
if(DEFINED ENV{VSINSTALLDIR})
  set(CMAKE_RC_COMPILER "$ENV{VSINSTALLDIR}/VC/Tools/Llvm/x64/bin/llvm-rc.exe" CACHE FILEPATH "" FORCE)
endif()

set(CMAKE_C_COMPILER clang-cl CACHE STRING "" FORCE)
set(CMAKE_CXX_COMPILER clang-cl CACHE STRING "" FORCE)
set(CMAKE_LINKER lld-link CACHE FILEPATH "" FORCE)
if(DEFINED ENV{VSINSTALLDIR})
  set(CMAKE_AR "$ENV{VSINSTALLDIR}/VC/Tools/Llvm/x64/bin/llvm-lib.exe" CACHE FILEPATH "" FORCE)
endif()
